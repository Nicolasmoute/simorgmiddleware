# ---------------------------------------------------------------------------
# SimOrg Middleware — environment configuration
# Copy to `.env` for local development. On Zeabur, set these as service
# environment variables instead.
# ---------------------------------------------------------------------------

# SQLite database location (Prisma). On Zeabur, point this at a mounted
# persistent volume so keys survive redeploys, e.g. file:/data/simorg.db
DATABASE_URL="file:./prisma/dev.db"

# --- SimOrg instances -------------------------------------------------------
# Base URL of each SimOrg public API (no trailing slash). The middleware
# appends the mirrored path to this.
SIMORG_FR_BASE_URL="https://qls-simaero.simorg.aero/api/public"
SIMORG_SA_BASE_URL="https://za-simaero.simorg.aero/api/public"

# Per-instance API token the middleware uses to call SimOrg. These grant full
# access to SimOrg; they MUST never be exposed to middleware clients.
SIMORG_FR_TOKEN="replace-with-france-simorg-token"
SIMORG_SA_TOKEN="replace-with-south-africa-simorg-token"

# How the token is presented to SimOrg. Defaults below send
# `Authorization: Bearer <token>`. Adjust if SimOrg expects a different header
# (e.g. SIMORG_AUTH_HEADER="X-Api-Key" and SIMORG_AUTH_SCHEME="").
SIMORG_AUTH_HEADER="Authorization"
SIMORG_AUTH_SCHEME="Bearer "

# Comma-separated list of admin emails (seeded via `npm run keys seed`).
ADMIN_EMAILS="n.moute@sim.aero,c.depirey@sim.aero"

# Default lifetime, in months, for self-service read-only keys.
DEFAULT_KEY_LIFETIME_MONTHS="3"

# --- Microsoft SSO (deferred to the next milestone; NextAuth v5) ------------
# AUTH_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=""
