# ---------------------------------------------------------------------------
# SimOrg Middleware — environment configuration
# Copy to `.env` for local development. On Zeabur, set these as service
# environment variables instead.
# ---------------------------------------------------------------------------

# SQLite database location (Prisma). On Zeabur, point this at a mounted
# persistent volume so keys survive redeploys, e.g. file:/data/simorg.db
DATABASE_URL="file:./prisma/dev.db"

# --- SimOrg instances (OAuth2 client credentials) ---------------------------
# SimOrg authenticates via OAuth2 client-credentials. The middleware exchanges
# each instance's client id/secret at its token endpoint for a short-lived
# access token, then calls the API with `Authorization: Bearer <token>`. These
# credentials grant full access to SimOrg and MUST never reach clients.

# France
SIMORG_FR_BASE_URL="https://simaero.simorg.aero"
SIMORG_FR_CLIENT_ID="replace-with-fr-client-id"
SIMORG_FR_CLIENT_SECRET="replace-with-fr-client-secret"
SIMORG_FR_TOKEN_URL="https://simaero.simorg.aero/api/access_token"

# South Africa
SIMORG_SA_BASE_URL="https://simaero-sa.simorg.aero"
SIMORG_SA_CLIENT_ID="replace-with-sa-client-id"
SIMORG_SA_CLIENT_SECRET="replace-with-sa-client-secret"
SIMORG_SA_TOKEN_URL="https://simaero-sa.simorg.aero/api/access_token"

# Shared OAuth settings. SIMORG_SCOPE defaults to "application". SIMORG_TOKEN_URL
# is an optional fallback used when a per-instance *_TOKEN_URL is not set.
SIMORG_SCOPE="application"
SIMORG_TOKEN_URL="https://simaero.simorg.aero/api/access_token"

# Comma-separated list of admin emails (seeded via `npm run keys seed`).
ADMIN_EMAILS="n.moute@sim.aero,c.depirey@sim.aero"

# Shared secret guarding the admin management API (/api/admin/keys) while SSO
# is deferred. Use a long random value, e.g. `openssl rand -hex 32`. If unset,
# the admin API is disabled (returns 503). Rotate by changing this + redeploy.
ADMIN_TOKEN=""

# Default lifetime, in months, for self-service read-only keys.
DEFAULT_KEY_LIFETIME_MONTHS="3"

# --- Microsoft SSO (deferred to the next milestone; NextAuth v5) ------------
